{
    "name": "backend-study-mentor",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "nodemon",
        "build": "tsc",
        "start": "node dist/index.js",
        "seed": "tsx prisma/seed.ts",
        "drills:verify": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/layer1-verifier/cli.ts",
        "drills:verify:typecheck": "tsc -p Verification/tsconfig.json --noEmit",
        "drills:verify:test": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/layer1-verifier/layer1.spec.ts",
        "drills:judge": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/layer2-content-judge/cli.ts",
        "drills:judge:test": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/layer2-content-judge/layer2.spec.ts",
        "drills:assign-keys": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/key-assignment-tool/cli.ts",
        "drills:assign-keys:test": "ts-node --project tsconfig.dev.json Verification/drills/question-banks/key-assignment-tool/keyAssignment.spec.ts",
        "drills:import": "ts-node --project tsconfig.dev.json Import/cli.ts",
        "drills:import:test": "ts-node --project tsconfig.dev.json Import/importer.spec.ts",
        "diagnostic:verify": "ts-node --project tsconfig.dev.json Verification/diagnostic/question-banks/layer1-verifier/cli.ts",
        "diagnostic:judge": "ts-node --project tsconfig.dev.json Verification/diagnostic/question-banks/layer2-content-judge/cli.ts",
        "ia:verify": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/layer1-verifier/cli.ts",
        "ia:verify:test": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/layer1-verifier/layer1.spec.ts",
        "ia:judge": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/layer2-content-judge/cli.ts",
        "ia:judge:test": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/layer2-content-judge/layer2.spec.ts",
        "ia:assign-keys": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/key-assignment-tool/cli.ts",
        "ia:assign-keys:test": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/key-assignment-tool/keyAssignment.spec.ts",
        "ia:import": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/importer/cli.ts",
        "ia:import:test": "ts-node --project tsconfig.dev.json Verification/ia/question-banks/importer/importer.spec.ts",
        "test": "npm run drills:verify:test && npm run drills:judge:test && npm run drills:assign-keys:test && npm run drills:import:test && npm run ia:verify:test && npm run ia:judge:test && npm run ia:assign-keys:test && npm run ia:import:test"
    },
    "prisma": {
        "seed": "tsx prisma/seed.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Sarthakyadav98/backend-study-mentor.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Sarthakyadav98/backend-study-mentor/issues"
    },
    "homepage": "https://github.com/Sarthakyadav98/backend-study-mentor#readme",
    "description": "",
    "devDependencies": {
        "@types/better-sqlite3": "^7.6.13",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/fs-extra": "^11.0.4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.7.0",
        "@types/pdf-parse": "^1.1.5",
        "@types/pg": "^8.15.6",
        "@types/textract": "^2.4.5",
        "@types/ws": "^8.18.1",
        "@types/xml2js": "^0.4.14",
        "nodemon": "^3.1.10",
        "prisma": "5.22.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.4",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@google-cloud/speech": "^7.2.1",
        "@google/generative-ai": "^0.24.1",
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "5.22.0",
        "@supabase/supabase-js": "2.86.0",
        "better-sqlite3": "^12.6.2",
        "canvas": "^3.2.0",
        "cloudinary": "^2.9.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "fs-extra": "^11.3.2",
        "jsonwebtoken": "^9.0.3",
        "mammoth": "^1.11.0",
        "multer": "^2.0.2",
        "openai": "^6.2.0",
        "pdf-parse": "^2.4.5",
        "pdf-poppler": "^0.2.3",
        "pdf2pic": "^3.2.0",
        "pdfjs-dist": "^5.4.394",
        "pg": "^8.16.3",
        "resend": "^6.17.2",
        "sharp": "^0.34.5",
        "tesseract.js": "^6.0.1",
        "textract": "^2.5.0",
        "uuid": "^13.0.0",
        "ws": "^8.19.0",
        "xml2js": "^0.6.2",
        "youtubei.js": "^15.1.1",
        "ytdlp-nodejs": "^2.3.5"
    }
}
