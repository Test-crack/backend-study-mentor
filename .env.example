NODE_ENV = 'production'
PORT = 4000
GEMINI_API_KEY = 'your_gemini_api_key_here'
SUPABASE_URL = 'https://your-project.supabase.co'
SUPABASE_SERVICE_ROLE_KEY = 'your_service_role_key_here'
SUPABASE_JWT_SECRET = 'your_jwt_secret_here'
# Public URL of the frontend. Invite links point at ${FRONTEND_URL}/auth/callback.
# MUST be the real site in production (e.g. https://testcrack.com) — a localhost
# value here sends invitees to localhost.
FRONTEND_URL = 'http://localhost:8080'
# Resend (transactional email — invites are minted server-side and sent via Resend)
RESEND_API_KEY = 'your_resend_api_key_here'
MAIL_FROM = 'TestCrack <auth@mail.testcrack.com>'



