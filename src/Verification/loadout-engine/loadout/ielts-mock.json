{
  "id": "ielts-mock",
  "label": "IELTS · Full Mock",

  "columns": [
    {
      "name": "skill",
      "kind": "enum",
      "members": ["LISTENING", "READING", "WRITING", "SPEAKING"],
      "invalidCode": "SKILL_INVALID"
    },
    {
      "name": "sub_skill",
      "kind": "enum",
      "members": ["GRAMMAR", "VOCABULARY", "COHERENCE", "TASK_RESPONSE", "FLUENCY", "PRONUNCIATION"],
      "invalidCode": "SUB_SKILL_INVALID"
    },
    {
      "name": "question_type",
      "kind": "enum",
      "members": ["MCQ", "TFNG", "WRITING_PROMPT", "SPEAKING_PROMPT"],
      "invalidCode": "QUESTION_TYPE_INVALID"
    },
    { "name": "task_type", "kind": "text" },
    { "name": "passage_id", "kind": "text" },
    { "name": "passage_text", "kind": "text" },
    { "name": "audio_url", "kind": "text" },
    {
      "name": "prompt_text",
      "kind": "text",
      "requireNonEmpty": true,
      "emptyCode": "PROMPT_TEXT_EMPTY"
    },
    {
      "name": "options",
      "kind": "json_object",
      "appliesWhen": { "column": "question_type", "in": ["MCQ"] },
      "when": { "column": "question_type", "in": ["MCQ"] },
      "requiredKeys": ["A", "B", "C", "D"],
      "requireNonEmptyValues": true,
      "requireUniqueValues": true,
      "codes": {
        "empty": "OPTIONS_EMPTY",
        "notJson": "OPTIONS_NOT_JSON",
        "notObject": "OPTIONS_NOT_OBJECT",
        "keysWrong": "OPTIONS_KEYS_WRONG",
        "valueNotString": "OPTION_VALUE_NOT_STRING",
        "valueEmpty": "OPTION_VALUE_EMPTY",
        "valueDuplicate": "OPTION_TEXT_DUPLICATE"
      }
    },
    {
      "name": "correct_answer",
      "kind": "text",
      "appliesWhen": { "column": "question_type", "in": ["MCQ", "TFNG"] },
      "variants": [
        {
          "when": { "column": "question_type", "in": ["MCQ"] },
          "kind": "json_string_enum",
          "allowed": ["A", "B", "C", "D"],
          "codes": {
            "empty": "CORRECT_ANSWER_EMPTY",
            "notJson": "CORRECT_ANSWER_NOT_A_KEY",
            "notString": "CORRECT_ANSWER_NOT_A_KEY",
            "notAllowed": "CORRECT_ANSWER_NOT_A_KEY"
          }
        },
        {
          "when": { "column": "question_type", "in": ["TFNG"] },
          "kind": "loose_enum",
          "allowed": ["T", "F", "NG"],
          "codes": {
            "empty": "CORRECT_ANSWER_EMPTY",
            "notAllowed": "CORRECT_ANSWER_NOT_A_KEY"
          }
        }
      ]
    },
    {
      "name": "explanation",
      "kind": "text",
      "appliesWhen": { "column": "question_type", "in": ["MCQ", "TFNG"] },
      "requireNonEmpty": true,
      "emptyCode": "EXPLANATION_EMPTY"
    },
    {
      "name": "exam_type",
      "kind": "enum",
      "members": ["IELTS", "SPOKEN", "OET", "GRE", "TOEFL", "PTE"],
      "blankAllowed": true,
      "invalidCode": "EXAM_TYPE_INVALID"
    }
  ],

  "sourceKeyColumn": "source_key",
  "embeddedHeaderThreshold": 4,

  "checkOrder": [
    "enums",
    "conditional",
    "text",
    "structured",
    "hook:promptRowShape",
    "hook:promptRowNoPassageAudio",
    "credit",
    "sourceKey"
  ],
  "enumOrder": ["skill", "sub_skill", "exam_type", "question_type"],

  "bucket": {
    "dimensions": ["skill", "sub_skill"]
  },

  "rowAllowList": {
    "keyColumn": "skill",
    "valueColumn": "question_type",
    "code": "QUESTION_TYPE_SKILL_MISMATCH",
    "allowed": {
      "LISTENING": ["MCQ"],
      "READING": ["MCQ", "TFNG"],
      "WRITING": ["MCQ", "WRITING_PROMPT"],
      "SPEAKING": ["MCQ", "SPEAKING_PROMPT"]
    }
  },

  "conditionalColumns": [
    {
      "column": "task_type",
      "byColumn": "question_type",
      "allowed": {
        "WRITING_PROMPT": ["Task1", "Task2"],
        "SPEAKING_PROMPT": ["Part1", "Part2", "Part3"]
      },
      "codes": {
        "required": "TASK_TYPE_REQUIRED",
        "invalid": "TASK_TYPE_INVALID",
        "notAllowed": "TASK_TYPE_NOT_ALLOWED"
      }
    }
  ],

  "sourceKey": {
    "prefix": "mock",
    "segments": ["skill", "sub_skill", "question_type"],
    "pad": 3,
    "words": {
      "skill": {
        "LISTENING": "listening",
        "READING": "reading",
        "WRITING": "writing",
        "SPEAKING": "speaking"
      },
      "sub_skill": {
        "GRAMMAR": "grammar",
        "VOCABULARY": "vocabulary",
        "COHERENCE": "coherence",
        "TASK_RESPONSE": "task_response",
        "FLUENCY": "fluency",
        "PRONUNCIATION": "pronunciation"
      },
      "question_type": {
        "MCQ": "mcq",
        "TFNG": "tfng",
        "WRITING_PROMPT": "writing_prompt",
        "SPEAKING_PROMPT": "speaking_prompt"
      }
    }
  },

  "filenameChecks": [
    { "dimension": "skill", "onMissing": "nameOther" },
    { "dimension": "sub_skill", "onMissing": "contradictOrUndetermined" }
  ],
  "filenameShowWords": false,

  "duplicateIdentity": [
    { "column": "prompt_text", "normalize": "foldCase" },
    { "column": "options", "normalize": "optionSignature" }
  ],

  "expectedRows": { "fallback": 5 },

  "warnings": {
    "explanationCredit": {
      "answerColumn": "correct_answer",
      "explanationColumn": "explanation",
      "optionKeys": ["A", "B", "C", "D"],
      "appliesWhen": { "column": "question_type", "in": ["MCQ"] },
      "message": "NEEDS HUMAN REVIEW: {answerColumn} is \"{stored}\", but the explanation appears to credit option {letter} as correct."
    }
  },

  "hooks": ["promptRowShape", "promptRowNoPassageAudio", "mockGrounding"]
}
