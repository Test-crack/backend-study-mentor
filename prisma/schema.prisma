model DrillSession {
  id                 String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  student_id         String             @db.Uuid
  skill              SkillType
  sub_skill          SubSkillType
  drill_type         String?
  prompts_completed  Int
