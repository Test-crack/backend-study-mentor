model StudentGameScore {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id      String           @db.Uuid
  game_type       String           @db.VarChar(30)
  session_date    DateTime         @default(dbgenerated("((now() AT TIME ZONE 'Asia/Kolkata'::text))::date")) @db.Date
  words_solved    Int              @default(0)
  total_words     Int              @default(0)
  bonus_eligible  Boolean          @default(false)
  momentum_earned Int              @default(0)
  completed       Boolean          @default(false)
  played_word_ids Json?
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  total_attempts  Int              @default(0)
  skipped         Boolean          @default(false)
  Student         InstituteStudent @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "student_game_scores_student_fk")

