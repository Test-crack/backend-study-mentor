generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  supabaseuserid String        @unique @db.VarChar(255)
  email          String        @unique @db.VarChar(255)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @db.Timestamptz(6)
  UserConcept    UserConcept[]

  @@index([email])
}

model Concept {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId         String        @unique @db.VarChar(100)
  baseConceptId     String        @db.VarChar(100)
  domain            String        @db.VarChar(50)
  conceptSlug       String        @db.VarChar(100)
  sequence          Int
  keywords          String[]      @default([])
  learningObjective String
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @db.Timestamptz(6)
  Content           Content?
  UserConcept       UserConcept[]

  @@unique([baseConceptId, sequence])
  @@index([baseConceptId])
  @@index([conceptSlug])
  @@index([domain])
  @@index([keywords], type: Gin)
}

model Content {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId   String      @unique @db.Uuid
  contentType ContentType
  title       String?     @db.VarChar(500)
  ytLink      String?     @db.VarChar(500)
  path        String?     @db.VarChar(1000)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @db.Timestamptz(6)
  Concept     Concept     @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conceptId])
  @@index([contentType])
}

model UserConcept {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  conceptId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  Concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, conceptId])
  @@index([conceptId])
  @@index([userId])
}

enum ContentType {
  YOUTUBE
  NOTES
  PDF
  TEXT
}
