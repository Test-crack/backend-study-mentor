  @@index([student_id])
  @@index([session_date])
  @@index([game_type, session_date], map: "idx_sgs_game_date")
  @@index([student_id, game_type, session_date, completed, words_solved, momentum_earned], map: "idx_sgs_student_game_date_cover")
  @@map("student_game_scores")
}

model LexiGridWord {
