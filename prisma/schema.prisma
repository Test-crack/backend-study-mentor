generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Concept {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId         String              @unique @db.VarChar(100)
  baseConceptId     String              @db.VarChar(100)
  domain            String              @db.VarChar(50)
  conceptSlug       String              @db.VarChar(100)
  sequence          Int
  keywords          String[]            @default([])
  learningObjective String
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @db.Timestamptz(6)
  Content           Content?
  CourseContentItem CourseContentItem[]
  ModuleConcept     ModuleConcept[]
  UserConcept       UserConcept[]

  @@unique([baseConceptId, sequence])
  @@index([baseConceptId])
  @@index([conceptSlug])
  @@index([domain])
  @@index([keywords], type: Gin)
}

model Content {
  id          String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conceptId   String      @unique @db.Uuid
  contentType ContentType
  title       String?     @db.VarChar(500)
  ytLink      String?     @db.VarChar(500)
  path        String?     @db.VarChar(1000)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @db.Timestamptz(6)
  Concept     Concept     @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conceptId])
  @@index([contentType])
}

model Course {
  id                   String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                String                 @db.VarChar(500)
  description          String?
  difficulty           DifficultyType?        @default(BEGINNER)
  duration_minutes     Int?
  price                Decimal?               @db.Decimal(10, 2)
  is_published         Boolean?               @default(false)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @db.Timestamptz(6)
  domainId             String                 @db.Uuid
  slug                 String?                @unique @db.VarChar(200)
  instructorId         String?                @db.Uuid
  thumbnail            String?
  Domain               Domain                 @relation(fields: [domainId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_course_domain")
  Instructor           Instructor?            @relation(fields: [instructorId], references: [id], onUpdate: NoAction, map: "fk_course_instructor")
  CourseModule         CourseModule[]
  CourseOrder          CourseOrder[]
  UserContentProgress  UserContentProgress[]
  UserCourseEnrollment UserCourseEnrollment[]
  UserModuleProgress   UserModuleProgress[]

  @@index([created_at], map: "idx_course_created_at")
  @@index([difficulty], map: "idx_course_difficulty")
  @@index([instructorId], map: "idx_course_instructor")
  @@index([is_published], map: "idx_course_published")
  @@index([slug], map: "idx_course_slug")
}

model CourseContentItem {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  concept_id          String                @db.Uuid
  content_kind        CourseContentType
  title               String?               @db.VarChar(300)
  sequence_order      Int?                  @default(0)
  is_required         Boolean?              @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  Concept             Concept               @relation(fields: [concept_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_concept")
  MCQ                 MCQ?
  Note                Note?
  UserContentProgress UserContentProgress[]

  @@index([concept_id], map: "idx_content_concept")
  @@index([content_kind], map: "idx_content_kind")
}

model CourseModule {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  course_id   String    @db.Uuid
  module_id   String    @db.Uuid
  order_index Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  Course      Course    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  Module      Module    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")

  @@unique([course_id, module_id], map: "unique_course_module")
  @@unique([course_id, order_index], map: "unique_course_module_position")
  @@index([course_id, order_index], map: "idx_course_module_composite")
}

model CourseOrder {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId            String         @db.Uuid
  courseId          String         @db.Uuid
  amount            Decimal        @db.Decimal(10, 2)
  currency          String         @default("INR") @db.VarChar(10)
  status            PurchaseStatus @default(PENDING)
  razorpayOrderId   String         @unique @db.VarChar(100)
  razorpayPaymentId String?        @unique @db.VarChar(100)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @db.Timestamptz(6)
  Course            Course         @relation(fields: [courseId], references: [id])
  User              User           @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model Domain {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?
  createdAt   DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @default(now()) @db.Timestamptz(6)
  Course      Course[]

  @@index([slug], map: "idx_domain_slug")
}

model IeltsReadingAssessment {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String   @db.Uuid
  reportId           String   @db.VarChar(100)
  passageTitle       String   @db.VarChar(500)
  category           String   @db.VarChar(100)
  wordCount          Int
  readingTimeSeconds Int
  wpm                Float
  accuracy           Float
  retentionScore     Float
  efficiencyScore    Float
  speedLearningScore Float
  grade              String   @db.VarChar(5)
  speedCategory      String?  @db.VarChar(50)
  totalQuestions     Int
  correctAnswers     Int
  scoredAnswers      Json?
  feedbackTips       String[] @default([])
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, category], map: "idx_ielts_reading_assessment_user_cat")
  @@index([userId, createdAt], map: "idx_ielts_reading_assessment_user_date")
  @@index([userId, grade], map: "idx_ielts_reading_assessment_user_grade")
}

model IeltsSpeakingAssessment {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String                @db.Uuid
  topicId               String                @db.Uuid
  band                  String                @db.VarChar(50)
  weightedWpm           Float
  fluencyScore          Float
  keywordsHit           Int
  totalKeywords         Int
  pass1Data             Json                  @db.Json
  pass2Data             Json                  @db.Json
  createdAt             DateTime              @default(now()) @db.Timestamptz(6)
  IeltsSpeakingPractice IeltsSpeakingPractice @relation(fields: [topicId], references: [id], onDelete: Cascade, map: "IeltsReadingAssessment_topicId_fkey")
  User                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([topicId], map: "IeltsReadingAssessment_topicId_idx")
  @@index([userId], map: "IeltsReadingAssessment_userId_idx")
}

model IeltsSpeakingPractice {
  id                      String                    @id(map: "IeltsReadingPractice_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                   String                    @db.VarChar(500)
  type                    String                    @db.VarChar(100)
  words                   Int
  phrases                 Int
  band                    String                    @db.VarChar(50)
  modelAnswer             String
  keywords                String[]                  @default([])
  keywordMap              Json?
  tips                    String[]                  @default([])
  createdAt               DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                  @default(now()) @db.Timestamptz(6)
  IeltsSpeakingAssessment IeltsSpeakingAssessment[]

  @@index([band], map: "idx_ielts_reading_practice_band")
}

model IeltsSpeedReadingExercise {
  id                      String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  reportId                String                  @db.Uuid
  type                    String                  @db.VarChar(50)
  question                String
  options                 Json?
  correctAnswer           String
  explanation             String?
  createdAt               DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                @default(now()) @db.Timestamptz(6)
  IeltsSpeedReadingReport IeltsSpeedReadingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model IeltsSpeedReadingReport {
  id                        String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category                  String                      @db.VarChar(50)
  title                     String                      @db.VarChar(255)
  source                    String                      @db.VarChar(255)
  text                      String
  wordCount                 Int                         @default(0)
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  IeltsSpeedReadingExercise IeltsSpeedReadingExercise[]

  @@index([category])
}

model IeltsVoicePrompt {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  band         String   @db.VarChar(50)
  feature      String   @default("anatomy") @db.VarChar(50)
  question     String
  hint         String?
  targetWpmMin Int      @default(120)
  targetWpmMax Int      @default(160)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([isActive], map: "idx_voice_prompt_active")
  @@index([band], map: "idx_voice_prompt_band")
  @@index([feature], map: "idx_voice_prompt_feature")
}

model IeltsWritingTask {
  id                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title                  String                   @db.VarChar(500)
  topic                  String
  assignedDate           DateTime                 @db.Date
  createdAt              DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                 @default(now()) @db.Timestamptz(6)
  IeltsWritingAssessment IeltsWritingAssessment[]

  @@index([assignedDate])
}

model IeltsWritingAssessment {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String           @db.Uuid
  taskId               String           @db.Uuid
  writtenContent       String
  wordCount            Int
  aiBandScore          String?          @db.VarChar(10)
  aiGrammarScore       Float?
  aiVocabularyScore    Float?
  aiCoherenceScore     Float?
  aiTaskResponseScore  Float?
  aiFeedbackData       Json?
  manualBandScore      String?          @db.VarChar(10)
  manualFeedback       String?
  gradedByInstructorId String?          @db.Uuid
  createdAt            DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime         @default(now()) @db.Timestamptz(6)
  IeltsWritingTask     IeltsWritingTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User                 User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([taskId])
}

model Instructor {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String   @unique @db.Uuid
  bio            String?
  specialization String?  @db.VarChar(255)
  rating         Float?   @default(0.0)
  socialLinks    Json?    @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @db.Timestamptz(6)
  Course         Course[]
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MCQ {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content_item_id   String            @unique @db.Uuid
  question          String
  options           Json
  correct_answer    String            @db.VarChar(50)
  explanation       String?
  difficulty        String?           @default("medium") @db.VarChar(20)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_item")
}

model Module {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title               String                @db.VarChar(300)
  description         String?
  domain              String?               @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  CourseModule        CourseModule[]
  ModuleConcept       ModuleConcept[]
  UserContentProgress UserContentProgress[]
  UserModuleProgress  UserModuleProgress[]

  @@index([domain], map: "idx_module_domain")
}

model ModuleConcept {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  module_id   String    @db.Uuid
  concept_id  String    @db.Uuid
  order_index Int
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  Concept     Concept   @relation(fields: [concept_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_concept")
  Module      Module    @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")

  @@unique([module_id, concept_id], map: "unique_module_concept")
  @@unique([module_id, order_index], map: "unique_module_concept_position")
  @@index([module_id, order_index], map: "idx_module_concept_composite")
}

model Note {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  content_item_id   String            @unique @db.Uuid
  format            String?           @default("markdown") @db.VarChar(20)
  body              String
  version           Int?              @default(1)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_item")
}

model ReadingAssessmentHistory {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String   @db.Uuid
  passageId          String   @db.VarChar(100)
  difficulty         String   @db.VarChar(20)
  category           String   @db.VarChar(100)
  wordCount          Int
  readingTimeSeconds Int
  actualWPM          Float
  weightedWPM        Float
  accuracy           Float
  retention          Float
  speedLearningScore Float
  focusRatio         Float
  integrityScore     Float
  tabSwitches        Int
  createdAt          DateTime @default(now()) @db.Timestamptz(6)
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([userId, difficulty])
}

model User {
  id                       String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  supabaseuserid           String                     @unique @db.VarChar(255)
  email                    String                     @unique @db.VarChar(255)
  createdAt                DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                   @default(now()) @db.Timestamptz(6)
  name                     String?                    @db.VarChar(255)
  countryCode              String?                    @db.VarChar(5)
  phoneNo                  String?                    @db.VarChar(20)
  role                     UserRoleType               @default(STUDENT)
  profileImage             String?
  CourseOrder              CourseOrder[]
  IeltsReadingAssessment   IeltsReadingAssessment[]
  IeltsSpeakingAssessment  IeltsSpeakingAssessment[]
  IeltsWritingAssessment   IeltsWritingAssessment[]
  Instructor               Instructor?
  ReadingAssessmentHistory ReadingAssessmentHistory[]
  UserConcept              UserConcept[]
  UserContentProgress      UserContentProgress[]
  UserCourseEnrollment     UserCourseEnrollment[]
  UserModuleProgress       UserModuleProgress[]
  UserReadingProfile       UserReadingProfile?
  ielts_batch_instructors  ielts_batch_instructors[]
  ielts_batch_students     ielts_batch_students[]
  ielts_batches            ielts_batches[]
  institute_admins         institute_admins?
  institute_instructors    institute_instructors?
  institute_owners         institute_owners?
  institute_students       institute_students?
  institutes               institutes[]

  @@index([email])
}

model UserConcept {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String   @db.Uuid
  conceptId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  Concept   Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, conceptId])
  @@index([conceptId])
  @@index([userId])
}

model UserContentProgress {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String            @db.Uuid
  course_id         String            @db.Uuid
  module_id         String            @db.Uuid
  content_item_id   String            @db.Uuid
  status            String            @default("NOT_STARTED") @db.VarChar(50)
  completed_at      DateTime?         @db.Timestamptz(6)
  last_accessed_at  DateTime          @default(now()) @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @db.Timestamptz(6)
  CourseContentItem CourseContentItem @relation(fields: [content_item_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_content_item")
  Course            Course            @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_course")
  Module            Module            @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_module")
  User              User              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_content_progress_user")

  @@unique([user_id, content_item_id], map: "unique_user_content_progress")
  @@index([last_accessed_at], map: "idx_content_last_accessed")
  @@index([user_id, course_id, module_id], map: "idx_user_content_lookup")
  @@index([user_id, status], map: "idx_user_content_status")
  @@index([user_id, module_id, last_accessed_at(sort: Desc)], map: "idx_user_module_content")
}

model UserCourseEnrollment {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String          @db.Uuid
  course_id        String          @db.Uuid
  enrolled_at      DateTime?       @default(now()) @db.Timestamptz(6)
  last_accessed_at DateTime?       @default(now()) @db.Timestamptz(6)
  completed_at     DateTime?       @db.Timestamptz(6)
  status           ProgressStatus? @default(NOT_STARTED)
  module_index     Int?            @default(0)
  Course           Course          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  User             User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@unique([user_id, course_id], map: "unique_user_course_enrollment")
  @@index([user_id, status], map: "idx_user_course_enrollment")
}

model UserModuleProgress {
  id               String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String          @db.Uuid
  module_id        String          @db.Uuid
  course_id        String          @db.Uuid
  status           ProgressStatus? @default(NOT_STARTED)
  completed_at     DateTime?       @db.Timestamptz(6)
  last_accessed_at DateTime?       @default(now()) @db.Timestamptz(6)
  Course           Course          @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_course")
  Module           Module          @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_module")
  User             User            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user")

  @@unique([user_id, module_id, course_id], map: "unique_user_module_progress")
  @@index([user_id, course_id], map: "idx_user_progress_lookup")
}

model UserReadingProfile {
  id                    String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId                String   @unique @db.Uuid
  currentWeightedWPM    Float
  currentRetention      Float
  currentSpeedLearning  Float
  currentFocusRatio     Float
  currentIntegrityScore Float
  highestWeightedWPM    Float
  highestRetention      Float
  highestSpeedLearning  Float
  lastAssessmentAt      DateTime @db.Timestamptz(6)
  totalAssessments      Int      @default(0)
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @db.Timestamptz(6)
  User                  User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model YouTubeTranscript {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  videoId      String   @unique @db.VarChar(20)
  title        String?  @db.VarChar(500)
  transcript   Json
  method       String?  @db.VarChar(50)
  language     String   @default("en") @db.VarChar(10)
  duration     Int?
  accessCount  Int      @default(0)
  lastAccessed DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)

  @@index([accessCount])
  @@index([lastAccessed])
  @@index([videoId])
}

model ielts_batch_instructors {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id      String        @db.Uuid
  user_id       String        @db.Uuid
  assigned_at   DateTime      @default(now()) @db.Timestamptz(6)
  ielts_batches ielts_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User          User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([batch_id, user_id])
  @@index([batch_id], map: "idx_ielts_batch_instructors_batch")
  @@index([user_id], map: "idx_ielts_batch_instructors_user")
}

model ielts_batch_students {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id      String        @db.Uuid
  user_id       String        @db.Uuid
  enrolled_at   DateTime      @default(now()) @db.Timestamptz(6)
  ielts_batches ielts_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User          User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([batch_id, user_id])
  @@index([batch_id], map: "idx_ielts_batch_students_batch")
  @@index([user_id], map: "idx_ielts_batch_students_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ielts_batches {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institute_id            String                    @db.Uuid
  name                    String                    @db.VarChar(255)
  description             String?
  status                  String                    @default("ACTIVE") @db.VarChar(20)
  max_students            Int?
  created_by              String?                   @db.Uuid
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  ielts_batch_instructors ielts_batch_instructors[]
  ielts_batch_students    ielts_batch_students[]
